// AI-Manager: エージェント/Webアプリ統合管理ダッシュボード

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VIEWER
}

enum ToolKind {
  WEB_APP
  AGENT
  SCHEDULED_BATCH
}

enum DevStatus {
  PLANNING
  IN_DEVELOPMENT
  ACTIVE
  PAUSED
  DEPRECATED
}

enum RunMode {
  ALWAYS_ON
  SCHEDULED
  MANUAL
}

enum HealthStatus {
  OK
  WARNING
  DOWN
  ERROR
  UNKNOWN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String
  role          Role     @default(VIEWER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invitesSent    Invite[]        @relation("InvitedBy")
  toolsCreated   Tool[]          @relation("ToolCreatedBy")
  auditLogs      AuditLog[]
  monthlyReviews MonthlyReview[]
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(VIEWER)
  token       String    @unique
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Tool {
  id          String    @id @default(cuid())
  slug        String    @unique
  nickname    String
  icon        String    @default("🤖")
  kind        ToolKind
  purpose     String
  devStatus   DevStatus @default(PLANNING)
  runMode     RunMode
  servicesUsed String   // カンマ区切り: Claude API, microCMS, Google Drive API など
  repoUrl     String?
  dashboardUrl String?  // 管理画面へのワンクリックリンク
  lastDeployedAt DateTime?

  // セキュリティ・権限（キー自体は保存しない。範囲とローテーション日のみ）
  apiKeyScopeNote      String?
  apiKeyLastRotatedAt  DateTime?

  // 状態報告用APIキー（ハッシュのみ保存。発行時に一度だけ平文を表示）
  reportKeyHash        String?  @unique
  reportKeyLastRotatedAt DateTime?

  // コスト管理
  monthlyFixedCostJpy   Int?     // 月額固定費（クラウドVM代など）
  monthlyBudgetJpy      Int?     // 従量課金分の予算上限（超過でアラート）

  // ドキュメント・引き継ぎ
  docUrl       String?  // 仕様書・要件整理へのリンク
  runbookText  String?  // 障害時の対応手順（誰が何をするか）

  // アクセス・操作: 起動/停止/再実行を叩く先のWebhook URL（未設定ならボタンは無効）
  controlWebhookUrl String?

  // アラート閾値（ツールごとにカスタマイズ可能。未設定ならデフォルト値を使用）
  alertFailureThreshold Int? // 連続失敗の回数（デフォルト3）
  alertStaleHours       Int? // 未報告とみなす時間（デフォルト24）

  createdBy   User      @relation("ToolCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  statusReports  StatusReport[]
  auditLogs      AuditLog[]
  costEntries    CostEntry[]
  monthlyReviews MonthlyReview[]
}

model CostEntry {
  id          String   @id @default(cuid())
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId      String
  yearMonth   String   // "2026-09" 形式
  usageCostJpy Int     // その月の従量課金実績（円）
  note        String?
  createdAt   DateTime @default(now())

  @@unique([toolId, yearMonth])
  @@index([toolId, yearMonth])
}

model MonthlyReview {
  id            String   @id @default(cuid())
  tool          Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId        String
  yearMonth     String   // "2026-09" 形式
  reviewedBy    User?    @relation(fields: [reviewedById], references: [id])
  reviewedById  String?
  riskScore     Int?     // 0-100などのリスクスコア（任意）
  notes         String?
  createdAt     DateTime @default(now())

  @@index([toolId, yearMonth])
}

model StatusReport {
  id             String       @id @default(cuid())
  tool           Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId         String
  status         HealthStatus
  message        String?
  processedCount Int?
  successCount   Int?
  nextRunAt      DateTime?
  reportedAt     DateTime     @default(now())

  @@index([toolId, reportedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     User?    @relation(fields: [actorId], references: [id])
  actorId   String?
  action    String
  tool      Tool?    @relation(fields: [toolId], references: [id])
  toolId    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
